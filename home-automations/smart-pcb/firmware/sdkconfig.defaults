# Shared by every product. products/<product>/sdkconfig.defaults adds its own settings, and each
# products/<product>/sdkconfig.defaults.<chip> file names a chip the product is built for.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_PHY_MAC_BB_PD=y

# Bluetooth only for commissioning
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# No Wi-Fi, Thread only
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_LWIP_IPV6_AUTOCONFIG=n

# OpenThread, as a sleepy end device (MTD)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_ND6=n
CONFIG_LWIP_IPV4=n
CONFIG_DISABLE_IPV4=y
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y

CONFIG_ENABLE_OTA_REQUESTOR=y
# A new image that restarts before it has started Matter (common/device.cpp marks it good then)
# is rolled back to the previous one by the bootloader. Only takes effect once flashed over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Matter update image (<project>-<version>-<target>.ota) for Home Assistant's Matter Server
CONFIG_CHIP_OTA_IMAGE_BUILD=y

# Light sleep between polls
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_IEEE802154_SLEEP_ENABLE=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
CONFIG_RTC_CLK_SRC_EXT_CRYS=n

# Intermittently connected device: polls the parent every 5 s while idle,
# so a command from Home Assistant arrives within ~5 s.
CONFIG_ENABLE_ICD_SERVER=y
CONFIG_ICD_SLOW_POLL_INTERVAL_MS=5000
CONFIG_ICD_FAST_POLL_INTERVAL_MS=500
CONFIG_ICD_IDLE_MODE_INTERVAL_SEC=60
CONFIG_ICD_ACTIVE_MODE_INTERVAL_MS=1000
# Stay in fast polling 5 s after the last message, so multi-step exchanges (pairing, the
# controller reading the device in) don't fall back to slow polling between steps.
CONFIG_ICD_ACTIVE_MODE_THRESHOLD_MS=5000

# Vendor and product name the controllers show (picked by CONFIG_PRODUCT_*)
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"

# Endpoints a product may create: root node, the product's own (valve head 2, Rollo 5) and the
# two diagnostics switches. Too low and creating an endpoint fails at start-up, which aborts the
# app in a restart loop (log: "Dynamic endpoint count cannot be greater than ...").
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=10
